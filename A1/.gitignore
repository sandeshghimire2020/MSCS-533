# ---------------------------------------------------------------- Dart / Flutter
# Everything here is regenerated by `flutter pub get` or `flutter build`.
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.g.dart
coverage/

# pubspec.lock is intentionally NOT ignored. It pins exact package versions so
# the project builds the same way on another machine.

# ------------------------------------------------------------------------- iOS
# Pods are restored by `pod install`; the xcconfig files are generated by
# Flutter and contain machine specific absolute paths.
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
*.ipa
*.dSYM.zip

# Xcode user state — window layout, breakpoints, scheme selections.
**/*.xcuserdatad/
**/*.xcworkspace/xcuserdata/
**/xcuserdata/

# --------------------------------------------------------------------- Android
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/app/debug/
**/android/app/release/
**/android/.cxx/
*.apk
*.aab
*.jks
*.keystore
key.properties
GeneratedPluginRegistrant.java

# ------------------------------------------------------------------- Editors
.idea/
*.iml
*.iws
.vscode/
!.vscode/settings.json

# ------------------------------------------------------------------------ OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# ------------------------------------------------------------------- Python
# make_report.py only needs python-docx; a local venv should not be committed.
venv/
.venv/
__pycache__/
*.pyc

# ------------------------------------------------------------ Report artefacts
# Word's lock files and autosave leftovers, not the report itself.
~$*.docx
*.tmp

# Screenshots are pasted into the Word document rather than tracked here.
screenshots/
fig*.png
